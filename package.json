{
  "name": "cyli",
  "version": "0.2.0",
  "description": "Interactive CLI/TUI for discovering and running Cypress tests.",
  "license": "MIT",
  "bin": {
    "cyli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cyli.example.json",
    "cyli.example.yarn.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=node --outdir=dist --minify --external ink --external react --external react-dom --banner='#!/usr/bin/env node' && chmod +x dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "lefthook": "^2.1.8",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
